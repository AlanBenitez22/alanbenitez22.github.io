const STORE_KEY="ch360_quests_v2";
let state=JSON.parse(localStorage.getItem(STORE_KEY)||"{}");
let filter="all";
const grid=document.getElementById("grid");

/* state[id] = { done:bool, status:'todo|doing|done', owner:str, resolution:str } */
function save(){localStorage.setItem(STORE_KEY,JSON.stringify(state));}
function getEntry(id){return state[id] || {};}
function isDone(id){return !!getEntry(id).done;}
function allItems(){return DATA.flatMap(s=>s.items);}
function itemMeta(id){ // resolve texto/objetivo a partir do id
  for(const s of DATA){const it=s.items.find(x=>x.id===id); if(it) return {sec:s,it};}
  return null;
}

function render(){
  grid.innerHTML="";
  DATA.forEach(sec=>{
    const total=sec.items.length;
    const done=sec.items.filter(it=>isDone(it.id)).length;
    const complete=done===total;
    const pct=total?Math.round(done/total*100):0;

    if(filter==="complete" && !complete) return;
    if(filter==="active" && complete) return;
    if(filter==="v1" && sec.ver!=="v1") return;
    if(filter==="v2" && sec.ver!=="v2") return;

    const card=document.createElement("div");
    card.className="quest"+(complete?" complete":"");

    let objsHtml="";
    sec.items.forEach(it=>{
      const e=getEntry(it.id);
      const on=!!e.done;
      const hasMemo=e.resolution && e.resolution.trim().length>0;
      objsHtml+=
        `<li class="obj${on?' done':''}" data-id="${it.id}" title="Clique para descrever a resolução">
           <span class="box${on?' on':''}"></span>
           <span class="txt">${it.t}</span>
           ${hasMemo?`<span class="memo" title="Resolução registrada">📝</span>`:""}
           ${it.w?`<span class="w">${it.w}</span>`:""}
         </li>`;
    });

    card.innerHTML=
      `<div class="quest-inner">
         <div class="quest-top">
           <div class="qicon">${complete?"✔":sec.icon}</div>
           <div class="qtitle"><h3>${sec.title}</h3><div class="sub">${sec.sub}</div></div>
           <span class="tag ${sec.ver}">${sec.ver.toUpperCase()}</span>
         </div>
         <div class="qprog">
           <div class="mini"><i style="width:${pct}%"></i></div>
           <span class="count">${done}/${total}</span>
         </div>
         ${sec.note?`<div class="note">⚠ ${sec.note}</div>`:""}
         <ul class="objs">${objsHtml}</ul>
         <div class="reward">
           <span>Missão ${sec.ver.toUpperCase()}</span>
           <span class="status">${complete?"✦ COMPLETA":pct+"%"}</span>
         </div>
       </div>`;

    card.querySelectorAll(".obj").forEach(li=>{
      li.addEventListener("click",()=>openModal(li.dataset.id));
    });

    grid.appendChild(card);
  });
}

function refreshHud(){
  const items=allItems();
  const total=items.length;
  const done=items.filter(it=>isDone(it.id)).length;
  const pct=total?Math.round(done/total*100):0;
  const questsDone=DATA.filter(s=>s.items.every(it=>isDone(it.id))).length;

  document.getElementById("hDone").textContent=done;
  document.getElementById("hLeft").textContent=total-done;
  document.getElementById("hPct").textContent=pct+"%";
  document.getElementById("hBar").style.width=pct+"%";
  document.getElementById("hLevel").textContent=questsDone+"/"+DATA.length;
}

/* ============ Modal de resolução ============ */
const overlay=document.getElementById("overlay");
let currentId=null;

function openModal(id){
  currentId=id;
  const meta=itemMeta(id);
  const e=getEntry(id);
  document.getElementById("mTag").textContent=meta.sec.title+" · "+meta.sec.ver.toUpperCase();
  document.getElementById("mTitle").textContent=meta.it.t;
  document.getElementById("mObj").textContent=meta.sec.sub+(meta.it.w?(" · peso "+meta.it.w):"");
  document.getElementById("mStatus").value=e.status || (e.done?"done":"todo");
  document.getElementById("mOwner").value=e.owner || "";
  document.getElementById("mResolution").value=e.resolution || "";
  overlay.classList.add("open");
  setTimeout(()=>document.getElementById("mResolution").focus(),60);
}
function closeModal(){overlay.classList.remove("open");currentId=null;}

document.getElementById("mSave").addEventListener("click",()=>{
  if(!currentId) return;
  const status=document.getElementById("mStatus").value;
  state[currentId]={
    status:status,
    done:status==="done",
    owner:document.getElementById("mOwner").value.trim(),
    resolution:document.getElementById("mResolution").value.trim()
  };
  save();closeModal();render();refreshHud();drawCharts();
});
document.getElementById("mClose").addEventListener("click",closeModal);
document.getElementById("mClear").addEventListener("click",()=>{
  document.getElementById("mResolution").value="";
});
overlay.addEventListener("click",e=>{if(e.target===overlay)closeModal();});
document.addEventListener("keydown",e=>{if(e.key==="Escape"&&overlay.classList.contains("open"))closeModal();});

/* ============ Gráficos (canvas puro) ============ */
function drawCharts(){
  drawBars();
  drawDonut();
  drawVStack();
}

function fitCanvas(cv){
  const dpr=window.devicePixelRatio||1;
  const w=cv.width, h=cv.height;
  if(cv.dataset.scaled!=="1"){
    cv.style.width=w+"px";cv.style.height=h+"px";
    cv.width=w*dpr;cv.height=h*dpr;
    cv.getContext("2d").scale(dpr,dpr);
    cv.dataset.scaled="1";cv.dataset.w=w;cv.dataset.h=h;
  }
  return {ctx:cv.getContext("2d"),w:+cv.dataset.w,h:+cv.dataset.h};
}

function drawBars(){
  const cv=document.getElementById("chartBars");
  const {ctx,w,h}=fitCanvas(cv);
  ctx.clearRect(0,0,w,h);
  const padL=70, padR=16, padT=6, padB=6;
  const n=DATA.length;
  const gap=4;
  const rowH=(h-padT-padB-(n-1)*gap)/n;
  DATA.forEach((sec,i)=>{
    const total=sec.items.length;
    const done=sec.items.filter(it=>isDone(it.id)).length;
    const pct=total?done/total:0;
    const y=padT+i*(rowH+gap);
    // label
    ctx.fillStyle="#c9b8ef";ctx.font="10px Lato, Arial";ctx.textAlign="right";ctx.textBaseline="middle";
    const label=sec.title.length>12?sec.title.slice(0,11)+"…":sec.title;
    ctx.fillText(label,padL-8,y+rowH/2);
    // track
    const barW=w-padL-padR;
    ctx.fillStyle="rgba(255,255,255,0.06)";
    roundRect(ctx,padL,y,barW,rowH,rowH/2);ctx.fill();
    // fill
    const g=ctx.createLinearGradient(padL,0,padL+barW,0);
    if(pct>=1){g.addColorStop(0,"#5affc0");g.addColorStop(1,"#4df0ff");}
    else{g.addColorStop(0,"#8b2fff");g.addColorStop(1,"#ff5ce1");}
    ctx.fillStyle=g;
    const fw=Math.max(pct>0?rowH:0,barW*pct);
    roundRect(ctx,padL,y,fw,rowH,rowH/2);ctx.fill();
    // pct text
    ctx.fillStyle="#f2ecff";ctx.font="9px Lato, Arial";ctx.textAlign="left";
    ctx.fillText(Math.round(pct*100)+"%",padL+barW-24,y+rowH/2);
  });
}

function drawDonut(){
  const cv=document.getElementById("chartDonut");
  const {ctx,w,h}=fitCanvas(cv);
  ctx.clearRect(0,0,w,h);
  const items=allItems();
  const total=items.length;
  const done=items.filter(it=>isDone(it.id)).length;
  const cx=w/2, cy=h/2, R=Math.min(w,h)/2-14, r=R*0.6;
  const segs=[{v:done,c1:"#5affc0",c2:"#4df0ff"},{v:total-done,c1:"#b14bff",c2:"#6a2fb0"}];
  let a=-Math.PI/2;
  const sum=total||1;
  segs.forEach(s=>{
    if(s.v<=0) return;
    const ang=s.v/sum*Math.PI*2;
    const g=ctx.createLinearGradient(cx-R,cy-R,cx+R,cy+R);
    g.addColorStop(0,s.c1);g.addColorStop(1,s.c2);
    ctx.beginPath();ctx.moveTo(cx,cy);
    ctx.arc(cx,cy,R,a,a+ang);ctx.closePath();
    ctx.fillStyle=g;ctx.fill();
    a+=ang;
  });
  // hole
  ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.fillStyle="#120a24";ctx.fill();
  // center text
  ctx.fillStyle="#fff";ctx.font="700 22px Lato, Arial";ctx.textAlign="center";ctx.textBaseline="middle";
  ctx.fillText(Math.round((done/sum)*100)+"%",cx,cy-4);
  ctx.fillStyle="#9a86c8";ctx.font="9px Lato, Arial";
  ctx.fillText(done+"/"+total+" feitas",cx,cy+14);
}

function drawVStack(){
  const cv=document.getElementById("chartV");
  const {ctx,w,h}=fitCanvas(cv);
  ctx.clearRect(0,0,w,h);
  const groups=["v1","v2"];
  const colors={
    v1done:"#4df0ff", v1rest:"#2a2050",
    v2done:"#ffd34d", v2rest:"#3a2a10"
  };
  const padT=14,padB=24,padX=40;
  const bw=60, gap=70;
  const maxH=h-padT-padB;
  const totalByVer=g=>DATA.filter(s=>s.ver===g).flatMap(s=>s.items).length;
  const doneByVer=g=>DATA.filter(s=>s.ver===g).flatMap(s=>s.items).filter(it=>isDone(it.id)).length;
  const maxCount=Math.max(totalByVer("v1"),totalByVer("v2"),1);
  const startX=(w-(bw*2+gap))/2;
  groups.forEach((g,idx)=>{
    const total=totalByVer(g), done=doneByVer(g);
    const x=startX+idx*(bw+gap);
    const colH=maxH*(total/maxCount);
    const doneH=total?colH*(done/total):0;
    const yBase=padT+maxH;
    // restante
    ctx.fillStyle=g==="v1"?colors.v1rest:colors.v2rest;
    roundRect(ctx,x,yBase-colH,bw,colH,6);ctx.fill();
    // feitas
    const grd=ctx.createLinearGradient(0,yBase-doneH,0,yBase);
    const dc=g==="v1"?colors.v1done:colors.v2done;
    grd.addColorStop(0,dc);grd.addColorStop(1,dc);
    ctx.fillStyle=dc;
    roundRect(ctx,x,yBase-doneH,bw,doneH,6);ctx.fill();
    // labels
    ctx.fillStyle="#c9b8ef";ctx.font="700 11px Lato, Arial";ctx.textAlign="center";ctx.textBaseline="top";
    ctx.fillText(g.toUpperCase(),x+bw/2,yBase+6);
    ctx.fillStyle="#fff";ctx.font="10px Lato, Arial";ctx.textBaseline="bottom";
    ctx.fillText(done+"/"+total,x+bw/2,yBase-colH-4);
  });
}

function roundRect(ctx,x,y,w,h,r){
  r=Math.min(r,w/2,h/2);
  ctx.beginPath();
  ctx.moveTo(x+r,y);
  ctx.arcTo(x+w,y,x+w,y+h,r);
  ctx.arcTo(x+w,y+h,x,y+h,r);
  ctx.arcTo(x,y+h,x,y,r);
  ctx.arcTo(x,y,x+w,y,r);
  ctx.closePath();
}

document.querySelectorAll(".chip").forEach(c=>{
  c.addEventListener("click",()=>{
    document.querySelectorAll(".chip").forEach(x=>x.classList.remove("active"));
    c.classList.add("active");
    filter=c.dataset.filter;
    render();
  });
});
document.getElementById("resetBtn").addEventListener("click",()=>{
  if(confirm("Limpar todo o progresso?")){state={};save();render();refreshHud();drawCharts();}
});

render();
refreshHud();
drawCharts();
window.addEventListener("resize",drawCharts);
</script>
